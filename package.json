{
  "name": "sign-caption-studio-root",
  "private": true,
  "version": "1.0.0",
  "description": "手语讲解视频字幕布局服务（Python 布局 + React 预览 + FFmpeg 输出）",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "npm run build --prefix frontend",
    "serve": "node scripts/run-server.mjs",
    "dev": "npm run dev --prefix frontend",
    "test": "python3 -m unittest discover -s backend/tests -v",
    "cli": "python3 -m signsub.cli"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
